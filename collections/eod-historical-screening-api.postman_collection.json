              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "query",
                  "description": "(Required) The search query (e.g., 'AAPL', 'Amazon', or ISIN 'US3453708600')"
