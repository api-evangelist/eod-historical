      "item": [
        {
          "id": "5b4f6d56-abc9-467c-982a-7bf1a0bc21ba",
          "name": "Get filtered stock data based on user-defined criteria.",
          "request": {
            "name": "Get filtered stock data based on user-defined criteria.",
            "description": {
              "content": "Retrieves stock data filtered by criteria such as market capitalization, exchange, sector, and more. Results can be sorted and paginated.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "screener"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "api_token",
                  "value": "<string>",
                  "description": "(Required) Your API token for authentication."
                },
                {
                  "disabled": false,
                  "key": "filters",
                  "value": "<string>",
                  "description": "Filters to apply, structured as nested arrays (e.g., [[\"field\", \"operation\", value], ...])."
                },
                {
                  "disabled": false,
                  "key": "signals",
                  "value": "<string>",
                  "description": "Signals to filter tickers by pre-calculated fields (e.g., 200d_new_hi, bookvalue_pos)."
                },
                {
                  "disabled": false,
                  "key": "sort",
                  "value": "<string>",
                  "description": "Sorts results by a specified field in ascending or descending order (e.g., market_capitalization.desc)."
                },
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "50",
                  "description": "Number of results per request. Minimum 1, maximum 500. Default is 50."
                },
                {
                  "disabled": false,
                  "key": "offset",
                  "value": "0",
                  "description": "Data offset for paginating results. Minimum 0, maximum 999. Default is 0."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
