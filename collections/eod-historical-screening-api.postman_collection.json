          "request": {
            "name": "Search stocks, companies, and ISINs",
            "description": {
              "content": "Search for stocks, companies, or ISINs by a query (e.g., company name, stock symbol, or ISIN)",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "search",
                ":query"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "api_token",
                  "value": "<string>",
                  "description": "(Required) API token for authentication"
                },
                {
                  "disabled": false,
                  "key": "fmt",
                  "value": "<string>",
                  "description": "Response format (e.g., 'json')"
