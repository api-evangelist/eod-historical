                  "description": "(Required) Your API key for authentication."
                },
                {
                  "disabled": false,
                  "key": "from",
                  "value": "<date>",
                  "description": "Start date for data retrieval in 'YYYY-MM-DD' format."
                },
                {
                  "disabled": false,
                  "key": "to",
                  "value": "<date>",
                  "description": "End date for data retrieval in 'YYYY-MM-DD' format."
                },
                {
                  "disabled": false,
                  "key": "reverse",
                  "value": "<string>",
                  "description": "Set to 'true' to reverse sort order (newest first)."
                },
                {
                  "disabled": false,
                  "key": "fmt",
                  "value": "json",
                  "description": "Output format, either 'json' or 'csv'. Defaults to 'json'."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "ticker",
                  "description": "(Required) The ticker symbol of the stock, e.g., 'AAPL.US' or simply 'AAPL'."
                }
              ]
            },
            "header": [
