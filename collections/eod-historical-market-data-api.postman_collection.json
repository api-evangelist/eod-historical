          "request": {
            "name": "Retrieve historical market capitalization data",
            "description": {
              "content": "Fetches historical market capitalization for a specified stock symbol with weekly frequency.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "historical-market-cap",
                ":ticker"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
