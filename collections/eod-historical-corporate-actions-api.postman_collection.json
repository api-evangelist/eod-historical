          "request": {
            "name": "Retrieve symbol change history",
            "description": {
              "content": "Retrieve the symbol change history within a specified date range. Only US exchanges are currently supported.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "symbol-change-history"
