              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "from",
                  "value": "<date>",
                  "description": "(Required) Start date for symbol change history in 'YYYY-MM-DD' format."
                },
                {
                  "disabled": false,
                  "key": "to",
                  "value": "<date>",
                  "description": "(Required) End date for symbol change history in 'YYYY-MM-DD' format."
                },
