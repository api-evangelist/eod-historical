        {
          "id": "6f127091-f314-4933-83ad-ed32196af82e",
          "name": "Retrieve insider transaction data",
          "request": {
            "name": "Retrieve insider transaction data",
            "description": {
              "content": "Fetch insider transaction data for US-listed companies. Covers insider buys and sells, providing transaction details such as date, shares, and price.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "insider-transactions"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "api_token",
                  "value": "<string>",
                  "description": "(Required) API token for authentication"
                },
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "100",
                  "description": "Max number of entries per result, from 1 to 1000. Default is 100."
                },
                {
                  "disabled": false,
                  "key": "from",
                  "value": "<date>",
                  "description": "Start date for transactions (format: YYYY-MM-DD). Defaults to one year before current date."
                },
                {
                  "disabled": false,
                  "key": "to",
                  "value": "<date>",
                  "description": "End date for transactions (format: YYYY-MM-DD). Defaults to current date."
                },
                {
                  "disabled": false,
                  "key": "code",
                  "value": "<string>",
                  "description": "Ticker symbol for filtering results (e.g., 'AAPL.US'). If omitted, returns data for all symbols."
                },
                {
                  "disabled": false,
                  "key": "fmt",
                  "value": "json",
                  "description": "Output format (only 'json' supported)."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
