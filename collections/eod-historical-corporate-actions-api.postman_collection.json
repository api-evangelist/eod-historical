                  "value": "<string>",
                  "description": "(Required) API token for authentication."
                },
                {
                  "disabled": false,
                  "key": "ex",
                  "value": "<string>",
                  "description": "Exchange code filter (e.g., 'US')."
                },
                {
                  "disabled": false,
                  "key": "fmt",
                  "value": "<string>",
                  "description": "Response format. Options are 'json' and 'csv'. Defaults to JSON."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
