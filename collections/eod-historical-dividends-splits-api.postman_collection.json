          "name": "Retrieve historical dividend data",
          "request": {
            "name": "Retrieve historical dividend data",
            "description": {
              "content": "Fetches historical dividend data for a specified stock symbol, including key dividend dates and values.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "div",
                ":ticker"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "api_token",
                  "value": "<string>",
                  "description": "(Required) Your API key for authentication."
                },
                {
                  "disabled": false,
                  "key": "from",
                  "value": "<date>",
                  "description": "Start date for data retrieval in 'YYYY-MM-DD' format. Defaults to earliest available data if not provided."
                },
                {
                  "disabled": false,
                  "key": "to",
                  "value": "<date>",
                  "description": "End date for data retrieval in 'YYYY-MM-DD' format. Defaults to latest available data if not provided."
                },
                {
                  "disabled": false,
                  "key": "fmt",
                  "value": "json",
                  "description": "Output format, either 'json' or 'csv'. Defaults to 'json'."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "ticker",
                  "description": "(Required) Ticker symbol of the stock in the format {SYMBOL_NAME}.{EXCHANGE_ID} (e.g., 'AAPL.US' for NASDAQ or 'AAPL.MX' for the Mexican Stock Exchange)."
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
