          "id": "9d84cd60-ddb9-4e3a-9415-d4f66f4b8ee9",
          "name": "Retrieve technical indicator data for a specified symbol.",
          "request": {
            "name": "Retrieve technical indicator data for a specified symbol.",
            "description": {
              "content": "Fetches technical indicator data, such as moving averages and other analytics, based on specified parameters.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "technical",
                ":ticker"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "api_token",
                  "value": "<string>",
                  "description": "(Required) Your API token for authentication."
                },
                {
                  "disabled": false,
                  "key": "function",
                  "value": "<string>",
                  "description": "(Required) The function to calculate the technical indicator (e.g., 'sma' for Simple Moving Average)."
                },
                {
                  "disabled": false,
                  "key": "period",
                  "value": "50",
                  "description": "Number of data points used to calculate the indicator. Default is 50."
                },
                {
                  "disabled": false,
                  "key": "from",
                  "value": "<date>",
                  "description": "Start date for data retrieval in 'YYYY-MM-DD' format."
                },
                {
                  "disabled": false,
                  "key": "to",
                  "value": "<date>",
                  "description": "End date for data retrieval in 'YYYY-MM-DD' format."
                },
                {
                  "disabled": false,
                  "key": "order",
                  "value": "a",
                  "description": "Sort order of dates: 'a' for ascending, 'd' for descending. Default is ascending."
                },
                {
                  "disabled": false,
                  "key": "fmt",
                  "value": "json",
                  "description": "Output format, either 'json' or 'csv'. Default is 'json'."
                },
                {
                  "disabled": false,
                  "key": "splitadjusted_only",
                  "value": "0",
                  "description": "For select functions, adjust data only for splits by setting to '1'. Default is '0'."
                },
                {
                  "disabled": false,
                  "key": "filter",
                  "value": "<string>",
                  "description": "Retrieve only the last value by specifying 'last_ema' or 'last_volume' as the filter."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "ticker",
                  "description": "(Required) Symbol in the format {SYMBOL_NAME}.{EXCHANGE_ID}, e.g., AAPL.US for Apple Inc."
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
