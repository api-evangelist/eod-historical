                "disableBodyPruning": true
              },
              "request": {
                "method": "GET",
                "header": [
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/eod/:ticker?api_token=<string>&fmt=csv&from=<date>&to=<date>&period=d&filter=last_low",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "eod",
                    ":ticker"
                  ],
                  "query": [
                    {
                      "description": "(Required) API token for authentication",
                      "key": "api_token",
                      "value": "<string>"
                    },
                    {
                      "description": "Response format (e.g., 'json')",
                      "key": "fmt",
                      "value": "csv"
                    },
                    {
                      "description": "Start date for historical data (YYYY-MM-DD)",
                      "key": "from",
                      "value": "<date>"
                    },
                    {
                      "description": "End date for historical data (YYYY-MM-DD)",
                      "key": "to",
                      "value": "<date>"
                    },
                    {
                      "description": "Data period (e.g., 'd' for daily, 'w' for weekly, 'm' for monthly)",
                      "key": "period",
                      "value": "d"
                    },
                    {
                      "description": "Filter for specific last known data points",
                      "key": "filter",
                      "value": "last_low"
                    }
                  ],
                  "variable": [
                    {
                      "id": "3ae5f395-0305-42c9-a5af-c58745ead79a",
                      "key": "ticker",
                      "value": "<string>",
                      "description": "(Required) Ticker symbol of the company"
                    }
                  ]
                },
                "description": "Retrieve end-of-day historical data for a specific company by its ticker symbol, with optional filters for specific data points."
