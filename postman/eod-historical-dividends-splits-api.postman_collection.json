              "protocolProfileBehavior": {
                "disableBodyPruning": true
              },
              "request": {
                "method": "GET",
                "header": [
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/div/:ticker?api_token=<string>&from=<date>&to=<date>&fmt=json",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "div",
                    ":ticker"
                  ],
                  "query": [
                    {
                      "description": "(Required) Your API key for authentication.",
                      "key": "api_token",
                      "value": "<string>"
                    },
                    {
                      "description": "Start date for data retrieval in 'YYYY-MM-DD' format. Defaults to earliest available data if not provided.",
