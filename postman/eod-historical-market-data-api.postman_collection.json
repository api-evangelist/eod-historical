                "header": [
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/historical-market-cap/:ticker?api_token=<string>&from=<date>&to=<date>&reverse=true&fmt=json",
